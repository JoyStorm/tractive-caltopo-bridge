# ===== Multi-team mode (one worker, many groups, many dogs) =====
# Point BRIDGE_CONFIG at a JSON file (or paste the JSON itself) — see
# groups.example.json. Keep passwords/keys out of the JSON with *_env fields:
#BRIDGE_CONFIG=groups.json
#SBSTAR_TRACTIVE_PASSWORD=...
#SBSTAR_CALTOPO_KEY=...
#SBSTAR_CALLSIGN_SECRET=...   # any long random string; e.g. `openssl rand -hex 16`
# When BRIDGE_CONFIG is set, the single-dog variables below are ignored.

# ===== Single-dog mode (original setup — still works unchanged) =====
# Tractive account (the app login — Tractive has no API keys)
TRACTIVE_EMAIL=you@example.com
TRACTIVE_PASSWORD=changeme

# CalTopo call sign, split at the first hyphen: {GROUP}-{DEVICE_ID}
# The bridge dates the device id per deployment: DEVICE_ID -> DEVICE_ID-yymmdd,
# so e.g. GROUP=TEAM1, DEVICE_ID=Dog posts as call sign TEAM1-Dog-260804.
CALTOPO_GROUP=TEAM1
CALTOPO_DEVICE_ID=Dog

# Recommended: makes call signs unguessable (TEAM1-Dog-260804-k3m9q) while
# staying the same across worker restarts that day. Changing it from blank
# to a value changes the call sign format — re-add the track on open maps.
#CALLSIGN_SECRET=

# Optional: push the call sign here when a deployment starts (space-separated;
# ntfy.sh topics, Slack or Discord webhooks)
#NOTIFY_URLS=https://ntfy.sh/your-long-random-topic

# Timezone the deployment date (yymmdd) is taken in
#BRIDGE_TZ=America/Los_Angeles

# Optional — only needed if the account has more than one collar
#TRACTIVE_TRACKER_ID=

# ===== Tuning (both modes) =====
#KEEPALIVE_SECONDS=240    # re-assert LIVE this often during a deployment
#MAX_LIVE_SECONDS=0       # 0 (default) = LIVE runs until stopped; e.g. 28800 = 8h cap
#REARM_SECONDS=60         # re-arm cadence after cell loss
#REARM_MAX_SECONDS=7200   # give up re-arming after this long offline
