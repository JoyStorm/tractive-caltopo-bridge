# Tractive account (the app login — Tractive has no API keys)
TRACTIVE_EMAIL=you@example.com
TRACTIVE_PASSWORD=changeme

# CalTopo call sign, split at the first hyphen: {GROUP}-{DEVICE_ID}
# The bridge dates the device id per deployment: DEVICE_ID -> DEVICE_ID-yymmdd,
# so e.g. GROUP=TEAM1, DEVICE_ID=Dog posts as call sign TEAM1-Dog-260804.
# Each deployment is its own CalTopo track; old maps never resurrect.
# The bridge is OFF by default and only reports while LIVE tracking is on,
# so the call sign only routes data during an active deployment. Still,
# don't publish your real one.
CALTOPO_GROUP=TEAM1
CALTOPO_DEVICE_ID=Dog

# Timezone the deployment date (yymmdd) is taken in
#BRIDGE_TZ=America/Los_Angeles

# Optional — only needed if the account has more than one collar
#TRACTIVE_TRACKER_ID=

# Optional tuning
#KEEPALIVE_SECONDS=240    # re-assert LIVE this often during a deployment
#MAX_LIVE_SECONDS=28800   # hard stop (8h) — battery protection if LIVE is forgotten
