# Tractive account (the app login — Tractive has no API keys)
TRACTIVE_EMAIL=you@example.com
TRACTIVE_PASSWORD=changeme

# CalTopo call sign, split at the first hyphen: {GROUP}-{DEVICE_ID}
# e.g. call sign TEAM1-Dog7k2q -> GROUP=TEAM1, DEVICE_ID=Dog7k2q
# SECRET: the call sign is the only auth CalTopo has. Use a random,
# unguessable DEVICE_ID and keep the real value out of anything public.
CALTOPO_GROUP=TEAM1
CALTOPO_DEVICE_ID=Dog7k2q

# Optional — only needed if the account has more than one collar
#TRACTIVE_TRACKER_ID=

# Optional tuning
#MODE=idle            # idle (default) or live
#POLL_IDLE_SECONDS=60
#POLL_LIVE_SECONDS=15
